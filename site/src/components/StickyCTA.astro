---
import { site, rupiah, waLink } from '../config/site';
import Icon from './Icon.astro';
---
<!-- Bar CTA mobile: muncul setelah hero lewat, disembunyikan saat section harga terlihat -->
<div id="sticky-cta" class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-line bg-card/95 p-3 backdrop-blur-md shadow-[0_-8px_24px_rgba(22,35,31,0.1)] transition-transform duration-300 md:hidden" data-hidden="true">
  <div class="flex items-center gap-3">
    <a href={waLink()} target="_blank" rel="noopener" class="grid size-12 shrink-0 place-items-center rounded-full border border-line text-brand transition-colors hover:border-brand" aria-label="Tanya via WhatsApp">
      <Icon name="wa" />
    </a>
    <a href="#harga" class="btn-primary flex-1">Gabung · {rupiah(site.pricing.special)}</a>
  </div>
</div>

<!-- Tombol WhatsApp melayang untuk desktop -->
<a href={waLink()} target="_blank" rel="noopener" class="fixed bottom-6 right-6 z-40 hidden size-14 place-items-center rounded-full bg-[#1f8f4e] text-white shadow-[0_12px_24px_-8px_rgba(31,143,78,0.5)] transition-transform duration-200 hover:scale-105 hover:bg-[#177a41] md:grid" aria-label="Tanya via WhatsApp">
  <Icon name="wa" class="size-7" />
</a>

<script>
  const bar = document.getElementById('sticky-cta');
  const hero = document.getElementById('hero-title');
  const price = document.getElementById('harga');
  if (bar && hero && price && 'IntersectionObserver' in window) {
    const state = { pastHero: false, atPrice: false };
    const render = () => bar.classList.toggle('translate-y-full', !state.pastHero || state.atPrice);
    new IntersectionObserver(([e]) => { state.pastHero = !e.isIntersecting && e.boundingClientRect.top < 0; render(); }).observe(hero);
    new IntersectionObserver(([e]) => { state.atPrice = e.isIntersecting; render(); }).observe(price);
  }
</script>
