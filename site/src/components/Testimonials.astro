---
import { testimonials } from '../data/content';
import Icon from './Icon.astro';
---
<section class="section" aria-labelledby="testi-title">
  <div class="container-x">
    <p class="eyebrow">Cerita peserta</p>
    <h2 id="testi-title" class="h2 mt-3">Apa kata mereka yang sudah menjalani</h2>
    <p class="mt-3 text-sm text-muted">Placeholder: ganti dengan testimoni asli yang sudah mendapat izin peserta.</p>
    <ul class="mt-10 grid gap-5 md:grid-cols-3" data-reveal-group>
      {testimonials.map((t) => (
        <li>
          <figure class="card-hover flex h-full flex-col">
            <div class="flex items-center justify-between">
              <span class="font-display text-5xl leading-none text-accent" aria-hidden="true">“</span>
              <div class="flex gap-0.5 text-accent" aria-hidden="true">
                {Array.from({ length: 5 }).map(() => <Icon name="star" class="size-4" />)}
              </div>
            </div>
            <blockquote class="mt-2 flex-1 text-ink/90">{t.quote}</blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-line pt-4">
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-[linear-gradient(155deg,var(--color-brand),var(--color-brand-dark))] font-semibold text-paper" aria-hidden="true">{t.name.charAt(0)}</span>
              <span><span class="block font-semibold">{t.name}</span><span class="text-sm text-muted">{t.role}</span></span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
