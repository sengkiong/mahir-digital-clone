---
import { faqs } from '../data/content';
---
<!-- <details> native: aksesibel & tanpa JavaScript -->
<section id="faq" class="section bg-card" aria-labelledby="faq-title">
  <div class="container-x grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title" class="h2 mt-3">Pertanyaan yang sering masuk</h2>
    </div>
    <div class="divide-y divide-line border-y border-line" data-reveal-group>
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold transition-colors hover:text-brand [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="grid size-8 shrink-0 place-items-center rounded-full border border-line text-brand transition-all duration-200 group-open:rotate-45 group-open:border-brand group-open:bg-brand-soft" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
