---
import { courses } from '../data/content';
import Icon from './Icon.astro';
const totalVideos = courses.reduce((s, c) => s + c.videos, 0);
---
<section id="kurikulum" class="section bg-card" aria-labelledby="curriculum-title">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="eyebrow">Kurikulum</p>
        <h2 id="curriculum-title" class="h2 mt-3">{courses.length} kelas, {totalVideos} video, satu urutan yang jelas</h2>
      </div>
      <p class="max-w-sm text-muted">Belum punya produk? Kami bantu rekomendasikan. Sudah punya? Kami bantu naikkan omzetnya.</p>
    </div>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {courses.map((c) => (
        <li class:list={[
          'flex flex-col rounded-2xl border p-6 transition-all duration-300 ease-out',
          c.featured
            ? 'border-brand bg-brand-soft shadow-[var(--shadow-card)] sm:col-span-2 lg:col-span-1 lg:row-span-2'
            : 'border-line bg-card shadow-[var(--shadow-card)] hover:-translate-y-1 hover:border-brand/30 hover:shadow-[var(--shadow-lift)]',
        ]}>
          <Icon name="book" class="size-7 text-brand" />
          {c.featured && <span class="mt-4 w-fit rounded-full bg-brand px-3 py-1 text-xs font-semibold text-white">Program utama</span>}
          <h3 class:list={['mt-4 font-semibold', c.featured ? 'font-display text-2xl font-semibold' : 'text-lg']}>{c.title}</h3>
          {c.featured && <p class="mt-3 text-muted">Dari setup akun, riset audiens, membuat materi iklan, sampai membaca data dan scale-up.</p>}
          <p class="mt-auto pt-4 text-sm text-muted">{c.chapters} bab · {c.videos} video</p>
        </li>
      ))}
    </ul>
  </div>
</section>
