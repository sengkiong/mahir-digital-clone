---
import { site } from '../config/site';
const nav = [
  { href: '#cara-belajar', label: 'Cara belajar' },
  { href: '#kurikulum', label: 'Kurikulum' },
  { href: '#harga', label: 'Harga' },
  { href: '#faq', label: 'FAQ' },
];
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/[0.92] backdrop-blur-md">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 font-display text-xl font-semibold text-brand-dark">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      {site.brand}
    </a>
    <nav aria-label="Navigasi utama" class="hidden md:block">
      <ul class="flex gap-8 text-sm font-medium text-muted">
        {nav.map((n) => (
          <li>
            <a class="group relative inline-block py-2 transition-colors hover:text-brand" href={n.href}>
              {n.label}
              <span class="absolute inset-x-0 -bottom-0.5 h-px origin-left scale-x-0 bg-brand transition-transform duration-200 ease-out group-hover:scale-x-100" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="#harga" class="btn-primary px-5! py-2.5! text-sm">Gabung sekarang</a>
  </div>
</header>
