---
import { partners } from "../data/content";
---
<section class="border-y border-line bg-card py-8" aria-labelledby="partner-title">
  <div class="container-x flex flex-col items-center gap-5 md:flex-row md:justify-between">
    <h2 id="partner-title" class="text-sm font-semibold tracking-wide text-muted">Berkolaborasi dengan</h2>
    <ul class="flex flex-wrap justify-center gap-x-8 gap-y-3 text-muted">
      {partners.map((p) => <li class="font-display text-lg font-medium text-ink/70">{p}</li>)}
    </ul>
  </div>
</section>
