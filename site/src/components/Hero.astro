---
import { site } from '../config/site';
import Icon from './Icon.astro';
const steps = [
  { label: 'Belajar', x: 30, y: 260 },
  { label: 'Praktik', x: 130, y: 188 },
  { label: 'Dibimbing', x: 215, y: 135 },
  { label: 'Hasil', x: 290, y: 40, goal: true },
];
---
<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-x-0 -top-24 -z-10 h-[32rem] bg-[radial-gradient(60%_60%_at_50%_0%,color-mix(in_oklab,var(--color-brand)_8%,transparent),transparent)]" aria-hidden="true"></div>
  <div class="container-x grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-[1.1fr_0.9fr]">
    <div data-reveal>
      <p class="eyebrow">Untuk pemula yang serius</p>
      <h1 id="hero-title" class="mt-4 font-display text-4xl leading-[1.1] font-semibold sm:text-5xl lg:text-6xl">
        Digital marketing tidak dikuasai dalam sehari. Anda butuh <span class="text-brand italic underline decoration-accent decoration-4 underline-offset-8">bimbingan rutin</span>.
      </h1>
      <p class="lead mt-6 max-w-xl">
        {site.brand} mengajak Anda belajar dari nol sampai bisa praktik dan menghasilkan dari rumah, dengan materi terstruktur dan mentor yang menemani setiap minggu.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#harga" class="btn-primary">Lihat program <Icon name="arrow" class="size-5" /></a>
        <a href="#video" class="btn-ghost"><Icon name="play" class="size-4 text-brand" /> Tonton cuplikan gratis</a>
      </div>
      <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 border-t border-line pt-6">
        <div><dt class="text-xs text-muted">Alumni</dt><dd class="font-display text-2xl font-semibold text-brand-dark">{site.stats.alumni}</dd></div>
        <div><dt class="text-xs text-muted">Tahun berjalan</dt><dd class="font-display text-2xl font-semibold text-brand-dark">{site.stats.years}+</dd></div>
        <div><dt class="text-xs text-muted">Sesi per bulan</dt><dd class="font-display text-2xl font-semibold text-brand-dark">{site.stats.classesPerMonth}</dd></div>
      </dl>
    </div>

    <div data-reveal class="bg-dotted relative overflow-hidden rounded-[2rem] bg-[linear-gradient(155deg,var(--color-brand),var(--color-brand-dark)_75%)] p-8 text-paper shadow-[var(--shadow-brand)]" aria-hidden="true">
      <svg viewBox="0 0 320 300" class="relative w-full">
        <path d="M30 260 C 90 260, 80 190, 150 185 S 230 120, 290 40" fill="none" stroke="var(--color-accent)" stroke-width="4" stroke-dasharray="2 12" stroke-linecap="round" />
        {steps.map((s) => (
          <g>
            <circle cx={s.x} cy={s.y} r={s.goal ? 18 : 12} fill={s.goal ? 'var(--color-accent)' : 'var(--color-paper)'} />
            <text x={s.goal ? s.x - 22 : s.x + 18} y={s.goal ? s.y + 42 : s.y - 14} fill="var(--color-paper)" font-size="15" font-family="Inter, sans-serif">{s.label}</text>
          </g>
        ))}
      </svg>
      <div class="relative mt-2 rounded-2xl bg-brand-darker/50 p-4 text-sm ring-1 ring-white/10">
        <p class="font-semibold">Minggu ini</p>
        <p class="mt-1 text-brand-soft">Live: membaca data kampanye pertama Anda</p>
      </div>
    </div>
  </div>
</section>
