---
// Urutan section mengikuti funnel referensi: masalah → solusi → bukti → harga → keberatan → CTA
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Pillars from '../components/Pillars.astro';
import LogoStrip from '../components/LogoStrip.astro';
import ValueProp from '../components/ValueProp.astro';
import MentoringChannels from '../components/MentoringChannels.astro';
import Audience from '../components/Audience.astro';
import Curriculum from '../components/Curriculum.astro';
import Testimonials from '../components/Testimonials.astro';
import Founder from '../components/Founder.astro';
import Pricing from '../components/Pricing.astro';
import VideoPreview from '../components/VideoPreview.astro';
import Benefits from '../components/Benefits.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <Pillars />
    <LogoStrip />
    <ValueProp />
    <MentoringChannels />
    <Audience />
    <Curriculum />
    <Testimonials />
    <Founder />
    <Pricing />
    <VideoPreview />
    <Benefits />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
  <StickyCTA />
</Base>
